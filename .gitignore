# ==========================================
# JalDrishti Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
*.env
*.env.*
*.env.local
!.env.example
.env
frontend/.env
backend/.env
dwlr-proto/.env
frontend/mongodb_passwords.txt
*credential*
*secret*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Frontend builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Bower (legacy - do not commit)
bower_components/
frontend/src/bower_components/

# Databases & local stores
*.sqlite3
*.db-journal
backend/data/*.db-journal

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
