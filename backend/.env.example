# JalDrishti Backend Environment Configuration Template
# Copy this file to .env and configure your local settings

MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=dwlr
DATABASE_URL=sqlite:///data/app.db
DEV_TRIGGER_TOKEN=dev-secret
DISABLE_SCHEDULER=true
ALERT_COOLDOWN_SECONDS=3600
CRITICAL_LEVEL=15.0

# Email Alerts Configuration (Optional - uncomment to enable real emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your-email@gmail.com

# Alternative: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

